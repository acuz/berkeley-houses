rules_version = '2';

// House Search — per-city access control.
// Each house carries a `city` field ('berkeley' | 'lausanne'). A user may only
// read/write houses of the cities they're listed for below. The web app hides
// inaccessible cities from the switcher, but THIS is the real boundary.
//
// NOTE: every house doc must have a `city` field, otherwise it is inaccessible.
service cloud.firestore {
  match /databases/{database}/documents {

    function cityUsers(c) {
      return c == 'lausanne'
        ? [
            'ewRt7NBEmtaCLKhAvtPuNmwPsC82',  // angelo.cuzzola@gmail.com
            'IWH4pFgarWcwEyDh7b3zTYAfprI2',  // claude-writer@berkeley.app (bot)
            'ItKOiRgYtiTXg1JeLRONWFRzHCh1'   // jacopo.marcheselli@gmail.com
          ]
        : [
            'ewRt7NBEmtaCLKhAvtPuNmwPsC82',  // angelo.cuzzola@gmail.com
            '1xdx8P6hoDTVE1udIHMUdSGXKwq1',  // irene.nicolino@gmail.com
            'IWH4pFgarWcwEyDh7b3zTYAfprI2'   // claude-writer@berkeley.app (bot)
          ];
    }

    function canAccess(c) {
      return request.auth != null && request.auth.uid in cityUsers(c);
    }

    match /houses/{houseId} {
      allow read:           if canAccess(resource.data.city);
      allow create:         if canAccess(request.resource.data.city);
      allow update, delete: if canAccess(resource.data.city);

      match /interactions/{intId} {
        allow read, write: if canAccess(
          get(/databases/$(database)/documents/houses/$(houseId)).data.city);
      }
    }
  }
}
